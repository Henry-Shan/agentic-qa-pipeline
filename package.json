{
  "name": "qa-pipeline",
  "private": true,
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "apps/site",
    "packages/widget",
    "worker"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/site",
    "dev:worker": "npm run dev --workspace=worker",
    "build": "npm run build:widget && npm run build --workspace=apps/site",
    "build:widget": "npm run build --workspace=packages/widget",
    "build:worker": "npm run build --workspace=worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "selftest": "npm run selftest --workspace=worker"
  },
  "engines": {
    "node": ">=22"
  }
}
