# worker/.env — copy to .env and fill in. Example values only; never commit real secrets.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-here

# The repo the agent fixes: a clone of YOUR app with the ship-task skill installed.
# Worktrees are created under WORKTREE_BASE, one per run.
RUNNER_REPO=/path/to/your-app
WORKTREE_BASE=/path/to/qa-pipeline-worktrees
CLAUDE_BIN=/opt/homebrew/bin/claude

# Model + reasoning effort for EVERY real claude spawn (dispatch, --resume steers,
# and the needs-human handoff summarizer). Defaults below need no .env entry.
# QA_CLAUDE_MODEL: opus | sonnet | fable | a full model name
# QA_CLAUDE_EFFORT: low | medium | high | xhigh | max
QA_CLAUDE_MODEL=opus
QA_CLAUDE_EFFORT=xhigh

SHIM_PORT=4519
MAX_RUNS=2
MAX_PREVIEWS=3
RUNS_PER_DAY=25

# Public URL of the QA site (the board). Used for origin checks and links.
SITE_URL=http://localhost:3200

# --- Previews ------------------------------------------------------------------
# local:  preview_url = http://localhost:<port> (visible on this machine only)
# tunnel: preview_url = https://<PREVIEW_HOST_PREFIX><reportId>.<PREVIEW_ZONE> via managed cloudflared
PREVIEW_MODE=local
PREVIEW_ZONE=example.com
PREVIEW_HOST_PREFIX=qa-preview-
CF_TUNNEL_NAME=qa-pipeline

# Where a preview's API calls go (your app's API origin). REQUIRED for previews to work.
PREVIEW_API_ORIGIN=https://api.example.com

# Inlined into the preview build. ANON key only — the worker refuses a service_role JWT.
PREVIEW_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PREVIEW_SUPABASE_ANON_KEY=anon-key-here

# Where the web app lives inside the repo, relative to the worktree root.
# Empty = the root itself; e.g. apps/web for a monorepo. Builds and `next start` run there.
PREVIEW_APP_DIR=

# Build command run inside each worktree before serving a preview (production build).
# PREVIEW_BUILD=0 falls back to the much slower dev server.
PREVIEW_BUILD=1
PREVIEW_BUILD_CMD=npm run build

# Hostnames the worker must never create DNS for (apex + www/api/app/qa of PREVIEW_ZONE
# are always protected). Comma-separated extras:
# PROTECTED_HOSTS=admin.example.com

# Fallback tester display name for auto-assign-on-block (contracts § Auto-assign on block):
# used when the reporter has no qa_allowed_emails.display_name.
QA_DEFAULT_ASSIGNEE=owner

# --- Optional overrides (mainly for tests; sensible defaults otherwise) -------
# QA_HOME=~/.qa-pipeline            # state dir: worker.lock, runs/, PAUSED, cloudflared.yml
# QA_MOCK_DISPATCH=1               # spawn mock/mock-run.mjs instead of claude (selftest)
# PREVIEW_CMD=node mock/mock-server.mjs --port   # preview launcher; chosen port is appended
# DISPATCH_STAGGER_MS=60000        # gap between dispatch starts (worktree setup mutates the runner checkout)
