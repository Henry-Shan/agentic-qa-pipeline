# worker/.env — copy to .env and fill in. Example values only; never commit real secrets.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-here

RUNNER_REPO=/Users/YOU/qa-pipeline-runner/the host app
WORKTREE_BASE=/Users/YOU/qa-pipeline-worktrees
CLAUDE_BIN=/opt/homebrew/bin/claude

SHIM_PORT=4519
MAX_RUNS=2
MAX_PREVIEWS=3
RUNS_PER_DAY=25

# local: preview_url = http://localhost:<port>
# tunnel: preview_url = https://preview-<runId>.<PREVIEW_DOMAIN> via managed cloudflared
PREVIEW_MODE=local
PREVIEW_DOMAIN=qa-preview.example.com
CF_TUNNEL_NAME=qa-pipeline

SITE_URL=https://qa.example.com

# --- Optional overrides (mainly for tests; sensible defaults otherwise) -------
# QA_HOME=~/.qa-pipeline           # state dir: worker.lock, runs/, PAUSED, cloudflared.yml
# QA_MOCK_DISPATCH=1               # spawn mock/mock-run.mjs instead of claude (selftest)
# PREVIEW_CMD=node mock/mock-server.mjs --port   # preview launcher; chosen port is appended
# DISPATCH_STAGGER_MS=60000        # gap between dispatch starts (worktree setup mutates the runner checkout)
